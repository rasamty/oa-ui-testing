<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet package metadata (dotnet pack) -->
    <PackageId>Repriori.BuildingBlocks.Auth</PackageId>
    <Version>1.0.0</Version>
    <Authors>Repriori</Authors>
    <Description>Reusable sign-in for ASP.NET Core apps: JWT access + rotating refresh tokens, optional TOTP 2FA, claim-based authorization policies, an admin API, and time-boxed trial windows. Knows nothing about any product.</Description>
    <PackageTags>authentication;authorization;jwt;totp;2fa;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core types: IEndpointRouteBuilder, HttpContext, PasswordHasher, DI -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
